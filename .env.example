# Copy this file to .env and fill in your key. .env is never committed.
OPENROUTER_API_KEY=

# Models are configuration, never code.
#
# The milestone 1 brief suggested developing on the 70B to save money. The
# freedom test on 2026-10-10 found that it breaks the narration contract in six
# of ten responses — narrating the player's thoughts, inventing their dialogue,
# and resolving a blackjack hand on its own — while being slower (3.0 s vs
# 1.6 s average) and only 0.2¢ per ten calls cheaper. So the play defaults are
# used from the start. Transcripts are in logs/freedom/.
RESOLVER_MODEL=nousresearch/hermes-4-405b
NARRATOR_MODEL=nousresearch/hermes-4-405b

# Compaction, the director, and catch-up. The 70B's looseness is harmless here
# and it is a third of the price.
BACKGROUND_MODEL=nousresearch/hermes-3-llama-3.1-70b

# Light mode (spec 12): run every role on BACKGROUND_MODEL. This adds no model
# name of its own — it is a remap onto the one configured above, so which model
# is cheap stays a .env decision.
#
# Read the note at the top before leaving it on. The 70B broke the narration
# contract in six of ten freedom-test responses. Code now gates a breach and
# regenerates rather than speaking it, but a regeneration is a second call, so
# a loose run can cost more than the 405B it was meant to undercut. Good for
# poking at plumbing; not for a session you want to keep.
#
# `/light` toggles it mid-session.
LIGHT_MODE=false

# Raw mode (spec 14): take the model at its word. The store, the dice, the
# clock and rule 5 still hold — those are not judgements and cannot be turned
# off. Everything that second-guesses the model does go: the contract gate, the
# near-duplicate filter, the turn refusals, and the routing of writes into the
# right table.
#
# This is the other arm of an open question. Six correction mechanisms exist
# because the model got something wrong once, and every one of them has since
# been wrong itself — one refused a turn twice and left the player with "say it
# again" on a turn the model had already handled correctly. Whether they earn
# their keep is measurable, and this is how.
#
# A raw world keeps writes that cannot be corrected later: a posture written as
# a fact is frozen by rule 3 forever. Do not play a world you want to keep.
# `/raw` toggles it mid-session.
RAW_MODE=false

# Where a new life starts.
SPAWN_CITY=Kansas City, Missouri

# Speech out (spec 13.2), through macOS `say`. Set false to play in text only.
VOICE_ENABLED=true

# Empty means the system voice. `say -v '?'` lists what is installed; the
# premium voices are a large download and sound far better than the defaults.
VOICE=

# Words per minute, 80 to 400. Empty means `say`'s own default, about 175.
VOICE_RATE=
